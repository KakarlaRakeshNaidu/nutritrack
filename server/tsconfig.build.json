{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "tests/**/*.ts",
    "tests-db/**/*.ts",
    "tests-browser/**/*.ts",
    "support/**/*.ts"
  ]
}
