PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://nutritrack_app:replace-me@database.example.com:5432/nutritrack
PG_CA_CERT_PATH=/absolute/path/to/aiven-ca.pem

