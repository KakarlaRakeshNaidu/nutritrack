PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://nutritrack_app:replace-me@database.example.com:5432/nutritrack
PG_CA_CERT_PATH=/absolute/path/to/aiven-ca.pem
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=24

# Optional Nodemailer SMTP delivery. Configure all five or leave all absent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_FROM=NutriTrack <no-reply@example.com>

# Gemini is optional. Leave both values absent to disable image extraction and
# meal-basics estimation; manual APIs remain available.
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=replace-me
